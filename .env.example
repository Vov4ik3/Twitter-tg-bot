# Rename this file to .env and fill in real values

# Token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# The chat ID your bot should post videos into (your meme group)
# Negative number for groups/supergroups, e.g. -1001234567890
# Leave it empty to send each video back to whoever sent the link (DM mode).
TARGET_CHAT_ID=-1001234567890

# Your own Telegram user ID (comma-separated if more than one person
# should be allowed to trigger the bot). Anyone else who DMs the bot
# is silently ignored.
ALLOWED_USER_IDS=123456789

# Optional: cookies in Netscape format (e.g. exported from your browser),
# needed for Instagram and for X/Reddit posts that require a login.
# COOKIES_FILE=cookies.txt
# ...or read them straight from a local browser instead (firefox, chrome, ...):
# COOKIES_FROM_BROWSER=firefox
