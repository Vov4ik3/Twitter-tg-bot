[Unit]
Description=Twitter/X to Telegram group bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change this to wherever you put the project
WorkingDirectory=%h/twitter-tg-bot
ExecStart=%h/twitter-tg-bot/venv/bin/python %h/twitter-tg-bot/bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
